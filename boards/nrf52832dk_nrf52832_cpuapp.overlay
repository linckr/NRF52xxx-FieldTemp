/* SPDX-License-Identifier: Apache-2.0 */
/* nRF52832 板级 overlay - 与 E104-BT5010A 相同引脚：UART 18/14, I2C 6/7, SPI 30/31/29, CS 28
 * 注意：52832 上 i2c0 与 spi0 共用 0x40003000，只能二选一，故 W25Q64 使用 spi1 (0x40004000)。 */

/ {
	aliases {
		/* 52832 上 I2C0 与 SPI0 共用基址，W25Q64 改用 SPI1 */
		w25q64-spi = &spi1;
	};
	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
	};
};

&uart0 {
	status = "okay";
	current-speed = <4800>;
	pinctrl-0 = <&uart0_default_custom>;
	pinctrl-1 = <&uart0_sleep_custom>;
	pinctrl-names = "default", "sleep";
};

&pinctrl {
	uart0_default_custom: uart0_default_custom {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 18)>,
			        <NRF_PSEL(UART_RX, 0, 14)>;
		};
	};

	uart0_sleep_custom: uart0_sleep_custom {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 18)>,
			        <NRF_PSEL(UART_RX, 0, 14)>;
			low-power-enable;
		};
	};

	i2c0_default_custom: i2c0_default_custom {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 7)>,
			        <NRF_PSEL(TWIM_SCL, 0, 6)>;
			bias-pull-up;
		};
	};

	i2c0_sleep_custom: i2c0_sleep_custom {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 7)>,
			        <NRF_PSEL(TWIM_SCL, 0, 6)>;
			low-power-enable;
			bias-pull-up;
		};
	};

	/* SPI1 用于 W25Q64（52832 上 SPI0 与 I2C0 共用基址，故用 SPI1）；port 0 引脚 30/31/29 */
	spi1_default_custom: spi1_default_custom {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 30)>,
			        <NRF_PSEL(SPIM_MOSI, 0, 31)>,
			        <NRF_PSEL(SPIM_MISO, 0, 29)>;
			bias-pull-down;
		};
	};

	spi1_sleep_custom: spi1_sleep_custom {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 30)>,
			        <NRF_PSEL(SPIM_MOSI, 0, 31)>,
			        <NRF_PSEL(SPIM_MISO, 0, 29)>;
			low-power-enable;
			bias-pull-down;
		};
	};
};

&uicr {
	/delete-property/ gpio-as-nreset;
};

/* 必须禁用 SPI0，否则与 I2C0 冲突（app.overlay 里默认启用了 spi0） */
&spi0 {
	status = "disabled";
};

&i2c0 {
	status = "okay";
	compatible = "nordic,nrf-twim";
	pinctrl-0 = <&i2c0_default_custom>;
	pinctrl-1 = <&i2c0_sleep_custom>;
	pinctrl-names = "default", "sleep";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	/delete-property/ zephyr,pm-device-runtime-auto;
};

/* 使用 SPI1 避免与 I2C0 冲突（52832 上 0 号外设只能 I2C 或 SPI 二选一） */
&spi1 {
	status = "okay";
	compatible = "nordic,nrf-spim";
	pinctrl-0 = <&spi1_default_custom>;
	pinctrl-1 = <&spi1_sleep_custom>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio0 28 GPIO_ACTIVE_LOW>;
	/delete-property/ zephyr,pm-device-runtime-auto;
	
	/* W25Q64 Flash 设备节点 */
	w25q64: w25q64@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <4000000>;  /* 降低到 4MHz 提高稳定性 */
		jedec-id = [ef 40 17];
		size = <67108864>;  /* 64 Mbit = 8 MB */
		has-dpd;
		t-enter-dpd = <3000>;
		t-exit-dpd = <30000>;
	};
};

&adc {
	/delete-property/ zephyr,pm-device-runtime-auto;
};

&flash_controller {
	status = "okay";
};

/* nRF52832 512KB Flash 分区 */
&flash0 {
	status = "okay";
	/delete-property/ zephyr,pm-device-runtime-auto;

	/delete-node/ partitions;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		/* Application (0x0 - 0x78000: 480KB) */
		slot0_partition: partition@0 {
			label = "image-0";
			reg = <0x00000000 0x00078000>;
		};

		/* NVS Storage (0x78000 - 0x7B000: 12KB) */
		nvs_partition: partition@78000 {
			label = "nvs_storage";
			reg = <0x00078000 0x00003000>;
		};
	};
};
