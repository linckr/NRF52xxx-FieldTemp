/*
 * WARNING: this file is NOT used by any build.
 *
 * The board target is `nrf52dk/nrf52810`; Zephyr hwmv2 only looks for
 * `<board>_<soc>.overlay` (i.e. `nrf52dk_nrf52810.overlay`).  There is no
 * `nrf52810dk` board, so this file is never applied — which is why SPI0 kept
 * running on the nRF52 DK default pins.  All board pin configuration for the
 * current target now lives in `app.overlay`; do not "fix" this by renaming it,
 * because a matching `boards/*.overlay` silently replaces `app.overlay`
 * (see cmake/modules/configuration_files.cmake).
 */

/ {
	
	chosen {
		/* 确保 console 使用 UART0 */
		zephyr,console = &uart0;
	};

};

/* 配置 UART0 - 参考 RIOT-2020.10-RC3 periph_conf.h */
/* E104-BT5010A: UART 映射到 USB 虚拟 COM 端口 */
/* 使用 pinctrl 方式配置引脚：P0.18 (TX), P0.14 (RX) */
&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default_custom>;
	pinctrl-1 = <&uart0_sleep_custom>;
	pinctrl-names = "default", "sleep";
};

/* 自定义 UART0 pinctrl 配置 - 覆盖默认配置 */
&pinctrl {
	uart0_default_custom: uart0_default_custom {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 18)>,  /* P0.18 - TXD */
			        <NRF_PSEL(UART_RX, 0, 14)>;  /* P0.14 - RXD */
		};
	};

	uart0_sleep_custom: uart0_sleep_custom {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 18)>,  /* P0.18 - TXD */
			        <NRF_PSEL(UART_RX, 0, 14)>;  /* P0.14 - RXD */
			low-power-enable;
		};
	};

	/* W25Q64 SPI0 pinctrl：SLK 30, MOSI 31, MISO 29 */
	spi0_default_custom: spi0_default_custom {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 30)>,
			        <NRF_PSEL(SPIM_MOSI, 0, 31)>,
			        <NRF_PSEL(SPIM_MISO, 0, 29)>;
			bias-pull-down;
		};
	};
	spi0_sleep_custom: spi0_sleep_custom {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 30)>,
			        <NRF_PSEL(SPIM_MOSI, 0, 31)>,
			        <NRF_PSEL(SPIM_MISO, 0, 29)>;
			low-power-enable;
			bias-pull-down;
		};
	};
};

/* SPI0 - W25Q64 Flash（52810 仅有一组 SPI，与 I2C 不冲突） */
&spi0 {
	status = "okay";
	compatible = "nordic,nrf-spim";
	pinctrl-0 = <&spi0_default_custom>;
	pinctrl-1 = <&spi0_sleep_custom>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio0 28 GPIO_ACTIVE_LOW>;
	/delete-property/ zephyr,pm-device-runtime-auto;
};

/* 删除 gpio-as-nreset 属性，因为 CONFIG_GPIO_AS_PINRESET=n */
/* E104-BT5010A 不需要使用 GPIO 作为复位引脚 */
&uicr {
	/delete-property/ gpio-as-nreset;
};
